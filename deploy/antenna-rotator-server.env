# Configuration for antenna-rotator-server.service; installed to
# /etc/antenna-rotator-server.env. See the README for every option.

# Use the stable /dev/serial/by-id/ name, not /dev/ttyUSB0, which can change
# between reboots. List the candidates with: ls -l /dev/serial/by-id/
ROTATOR_PORT=/dev/serial/by-id/CHANGE-ME

ROTATOR_PROTOCOL=prosistel
#ROTATOR_BAUD=9600

# Only used until an offset is first set via POST /api/v1/offset; after that
# the saved value in ROTATOR_OFFSET_FILE wins.
#ROTATOR_HEADING_OFFSET=0

#LISTEN_ADDR=:8080
#LOG_LEVEL=info
